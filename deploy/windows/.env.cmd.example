@echo off

rem Required: FastGPT check agent
set "AI_AGENT_CHECK_BASE_URL=https://aigpt.centanet.com"
set "AI_AGENT_CHECK_API_KEY=replace-with-check-agent-token"

rem Required: FastGPT rewrite agent
set "AI_AGENT_REWRITE_BASE_URL=https://aigpt.centanet.com"
set "AI_AGENT_REWRITE_API_KEY=replace-with-rewrite-agent-token"

rem Optional
set "AI_AGENT_CHECK_TIMEOUT_MS=15000"
set "AI_AGENT_REWRITE_TIMEOUT_MS=15000"
set "PORT=3000"
set "HOSTNAME=0.0.0.0"
